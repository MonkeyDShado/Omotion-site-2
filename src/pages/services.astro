---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteButton from '../components/QuoteButton.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="Services"
  description="Key visuals et montage vidéo pour les PME et les entrepreneurs : un rendu professionnel, assisté par l’IA, avec un budget maîtrisé."
>
  <div class="container page">
    <h1>Services</h1>
    <p class="lead">
      Deux services, pour les PME et les entrepreneurs qui veulent une image professionnelle sans budget
      d’agence.
    </p>

    {
      services.map((service) => (
        <section class="service" id={service.id} aria-labelledby={`${service.id}-title`}>
          <h2 id={`${service.id}-title`}>{service.title}</h2>
          {service.details.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {service.formulas && (
            <div class="formulas">
              {service.formulas.map((formula) => (
                <div class="formula">
                  <h3>{formula.title}</h3>
                  <p>{formula.description}</p>
                </div>
              ))}
            </div>
          )}
        </section>
      ))
    }

    <section class="service" aria-labelledby="ai-title">
      <h2 id="ai-title">Ma façon de travailler avec l’IA</h2>
      <p>
        J’utilise l’IA pour explorer plus de pistes, plus vite, et garder des coûts raisonnables. Les
        vidéos scénarisées sont entièrement générées par l’IA ; dans tous les cas, la direction artistique,
        les choix et le montage final restent les miens. Chaque projet du portfolio précise ce qu’a fait
        l’IA et ce que j’ai fait moi-même.
      </p>
    </section>

    <section class="service" aria-labelledby="process-title">
      <h2 id="process-title">Déroulement et délais</h2>
      <p class="placeholder">[À COMPLÉTER — étapes d’un projet et délais indicatifs]</p>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <h2 id="cta-title">Vous avez un projet ?</h2>
      <p>Décrivez-le en quelques lignes. Je vous réponds avec un devis.</p>
      <QuoteButton />
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12) var(--space-24);
  }

  .lead {
    font-size: var(--text-lg);
  }

  .service {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-mist);
  }

  .formulas {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .formula {
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-violet);
  }

  .formula:last-child {
    border-left-color: var(--color-rose);
  }

  .formula p {
    margin: 0;
  }

  @media (min-width: 48em) {
    .formulas {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .cta {
    margin-top: var(--space-8);
    padding: var(--space-8) var(--gutter);
    background: var(--color-mist);
  }
</style>
