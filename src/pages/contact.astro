---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { whatsapp } from '../data/contact';
---

<BaseLayout title="Demander un devis" description="Décrivez votre projet de key visual ou de vidéo : je vous réponds sous 24 h avec un devis." hideQuoteBar>
  <div class="container page">
    <h1>Demander un devis</h1>
    <p>Décrivez votre projet en quelques lignes. Je vous réponds sous 24 h.</p>
    <section class="fast" aria-labelledby="fast-title">
      <h2 id="fast-title">Le plus rapide : WhatsApp</h2>
      <p>Envoyez-moi un message au {whatsapp.number}, avec si possible une image ou un lien d’inspiration.</p>
      <WhatsAppButton />
    </section>

    <section class="form-zone" aria-labelledby="form-title">
      <h2 id="form-title">Ou par formulaire</h2>
      <p class="placeholder">[À COMPLÉTER — formulaire de devis (service de formulaire à choisir)]</p>
    </section>

    <section aria-labelledby="social-title">
      <h2 id="social-title">Suivez mon travail</h2>
      <SocialLinks />
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12) var(--space-24);
  }

  section {
    margin-top: var(--space-12);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .fast {
    padding: var(--space-8) var(--gutter);
    background: var(--color-mist);
  }
</style>
