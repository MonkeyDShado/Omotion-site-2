---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);

const contextLabels = {
  client: project.data.client,
  'auto-promotion': 'Auto-promotion O’Motion',
  concept: 'Création de démonstration',
} as const;
---

<BaseLayout title={project.data.title} description={project.data.coverAlt}>
  <article class="container page">
    <h1>{project.data.title}</h1>
    <p>{contextLabels[project.data.context]}</p>
    <Content />
    <section aria-labelledby="ai-role">
      <h2 id="ai-role">Rôle de l’IA</h2>
      <p>{project.data.aiRole}</p>
    </section>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12) var(--space-24);
  }
</style>
