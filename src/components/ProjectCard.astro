---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { themes } from '../data/themes';
import { contextLabel, countLabel } from '../data/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { data } = project;
---

<article class="card" data-theme={data.theme} data-category={data.category}>
  <a href={`/projets/${project.id}`} class="link">
    <div class="media">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[400, 700, 1000]}
        sizes="(min-width: 64em) 30vw, (min-width: 40em) 45vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
      />
    </div>
    <h3>{data.title}</h3>
  </a>
  <p class="meta">
    <span>{themes[data.theme]}</span>
    <span>{countLabel(project)}</span>
  </p>
  <p class="context">{contextLabel(project)}</p>
</article>

<style>
  .card {
    break-inside: avoid;
    margin-bottom: var(--space-8);
  }

  .link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .media {
    overflow: hidden;
    background: var(--color-mist);
  }

  .media :global(img) {
    width: 100%;
    height: auto;
    transition: transform var(--duration-slow) var(--ease-fluid);
  }

  .link:hover .media :global(img) {
    transform: scale(1.03);
  }

  h3 {
    margin: var(--space-3) 0 var(--space-1);
    font-size: var(--text-lg);
  }

  .link:hover h3 {
    color: var(--color-violet);
  }

  .meta,
  .context {
    margin: 0;
    font-size: var(--text-sm);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .meta span + span::before {
    content: '·';
    margin-right: var(--space-3);
    color: var(--color-violet);
  }

  .context {
    color: var(--color-magenta);
  }
</style>
