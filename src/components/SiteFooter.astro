---
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/omotion-logo-light.png';
import SocialLinks from './SocialLinks.astro';
import WhatsAppButton from './WhatsAppButton.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <div class="container inner">
    <Image src={logoLight} densities={[1, 2]} alt="O’Motion" width={111} height={90} />

    <div class="contact">
      <p class="tagline">Un projet ? Écrivez-moi, je réponds sous 24 h.</p>
      <WhatsAppButton />
      <SocialLinks />
    </div>

    <nav aria-label="Liens secondaires">
      <a href="/contact">Contact</a>
      <a href="/mentions-legales">Mentions légales</a>
    </nav>

    <p class="copyright">© {year} O’Motion</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-12) var(--space-24);
  }

  .inner {
    display: grid;
    gap: var(--space-6);
  }

  .contact {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .tagline {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  a {
    color: var(--color-paper);
  }

  a:hover {
    color: var(--color-paper);
    text-decoration-color: var(--color-rose);
  }

  .copyright {
    margin: 0;
    font-size: var(--text-sm);
  }

  @media (min-width: 48em) {
    .site-footer {
      padding-bottom: var(--space-12);
    }
  }
</style>
