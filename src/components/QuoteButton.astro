---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a href="/contact" class:list={['quote-button', className]}>Demander un devis</a>

<style>
  .quote-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-6);
    border-radius: 999px;
    background: var(--color-violet);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    isolation: isolate;
  }

  /* Signature : le dégradé du symbole apparaît au survol */
  .quote-button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-violet), var(--color-magenta));
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-fluid);
  }

  .quote-button:hover {
    color: var(--color-paper);
  }

  .quote-button:hover::before {
    opacity: 1;
  }
</style>
