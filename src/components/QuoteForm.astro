---
import { web3formsKey } from '../data/contact';

const ready = web3formsKey.length > 0;
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
---

<form
  class="quote-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-quote-form
  novalidate
>
  <input type="hidden" name="access_key" value={web3formsKey} />
  <input type="hidden" name="subject" value="Nouvelle demande de devis — O’Motion" />
  <input type="hidden" name="from_name" value="Site O’Motion" />
  {site && <input type="hidden" name="redirect" value={`${site}/merci`} />}
  <!-- Piège à robots : invisible pour les visiteurs -->
  <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="row">
    <label>
      <span>Nom <abbr title="obligatoire">*</abbr></span>
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label>
      <span>E-mail <abbr title="obligatoire">*</abbr></span>
      <input type="email" name="email" autocomplete="email" inputmode="email" required />
    </label>
  </div>

  <fieldset>
    <legend>Service souhaité <abbr title="obligatoire">*</abbr></legend>
    <div class="choices">
      <label class="choice"><input type="radio" name="service" value="Key visual" required /> <span>Key visual</span></label>
      <label class="choice"><input type="radio" name="service" value="Vidéo" /> <span>Vidéo</span></label>
      <label class="choice"><input type="radio" name="service" value="Les deux" /> <span>Les deux</span></label>
    </div>
  </fieldset>

  <div class="row">
    <label>
      <span>Budget indicatif</span>
<input type="text" name="budget" placeholder="Ex. 150 €, 1 500 MAD, 100 000 FCFA" />
    </label>
    <label>
      <span>Délai souhaité</span>
      <select name="delai">
        <option value="">Pas de date précise</option>
        <option>Urgent (moins d’une semaine)</option>
        <option>Dans les 2 semaines</option>
        <option>Dans le mois</option>
      </select>
    </label>
  </div>

  <label>
    <span>Votre projet <abbr title="obligatoire">*</abbr></span>
    <textarea name="message" rows="6" required placeholder="Votre produit ou événement, le message à faire passer, où le visuel ou la vidéo sera diffusé…"></textarea>
  </label>

  <label>
    <span>Lien d’inspiration (facultatif)</span>
    <input type="url" name="reference" inputmode="url" placeholder="https://" />
  </label>

  <p class="privacy">
    Vos informations servent uniquement à répondre à votre demande. Voir les <a href="/mentions-legales">mentions légales</a>.
  </p>

  {!ready && <p class="placeholder">[À COMPLÉTER — clé Web3Forms : l’envoi est désactivé en attendant]</p>}

  <button type="submit" class="submit" disabled={!ready}>Envoyer ma demande</button>
  <p class="status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    status.textContent = 'Envoi en cours…';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.message);
      window.location.href = '/merci';
    } catch {
      status.textContent =
        'L’envoi n’a pas abouti. Réessayez dans un instant, ou écrivez-moi directement sur WhatsApp.';
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .quote-form {
    display: grid;
    gap: var(--space-6);
    max-width: 44rem;
  }

  .row {
    display: grid;
    gap: var(--space-6);
  }

  label,
  fieldset {
    display: grid;
    gap: var(--space-2);
  }

  label > span,
  legend {
    font-family: var(--font-display);
    font-weight: 600;
  }

  abbr {
    color: var(--color-magenta);
    text-decoration: none;
  }

  input:not([type='radio'], [type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-ink);
    border-radius: 12px;
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--color-violet);
    outline-offset: 2px;
    border-color: var(--color-violet);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    margin-bottom: var(--space-2);
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .choice {
    position: relative;
    display: inline-flex;
  }

  .choice input {
    position: absolute;
    opacity: 0;
  }

  .choice span {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 500;
    cursor: pointer;
  }

  .choice input:checked + span {
    border-color: var(--color-violet);
    background: var(--color-violet);
    color: var(--color-paper);
  }

  .choice input:focus-visible + span {
    outline: 2px solid var(--color-violet);
    outline-offset: 3px;
  }

  .trap {
    position: absolute;
    left: -9999px;
  }

  .privacy {
    margin: 0;
    font-size: var(--text-sm);
  }

  .submit {
    justify-self: start;
    min-height: 48px;
    padding: var(--space-2) var(--space-8);
    border: 0;
    border-radius: 999px;
    background: var(--color-violet);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
  }

  .submit:hover:not(:disabled) {
    background: var(--color-magenta);
  }

  .submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .status {
    margin: 0;
    font-weight: 500;
  }

  @media (min-width: 40em) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
