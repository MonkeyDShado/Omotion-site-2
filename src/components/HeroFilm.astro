---
import { getImage } from 'astro:assets';
import QuoteButton from './QuoteButton.astro';
import type { HeroFilm } from '../data/hero';

interface Props {
  film: HeroFilm;
}

const { film } = Astro.props;
const poster = await getImage({ src: film.poster, width: 720, format: 'webp' });
const backdrop = await getImage({ src: film.poster, width: 64, format: 'webp' });
---

<section class="hero-film on-night" style={`--backdrop: url(${backdrop.src})`} aria-labelledby="hero-title">
  <div class="inner container">
    <figure class="film" style={`aspect-ratio: ${film.width} / ${film.height}`}>
      <video
        muted
        loop
        playsinline
        preload="metadata"
        poster={poster.src}
        width={film.width}
        height={film.height}
        data-hero-video
        aria-hidden="true"
      >
        {film.loopWebm && <source src={film.loopWebm} type="video/webm" />}
        <source src={film.loopMp4} type="video/mp4" />
      </video>
      <button type="button" class="toggle" data-hero-toggle aria-pressed="false">Pause</button>
    </figure>

    <div class="text">
      <h2 id="hero-title">Des images au rendu studio, sans le budget d’un tournage.</h2>
      <p class="lead">Key visuals et vidéos pour les PME et les entrepreneurs, créés avec l’IA et une vraie direction artistique.</p>
      <div class="actions">
        <QuoteButton />
        {
          film.youtubeId && (
            <a class="watch" href={`https://www.youtube.com/watch?v=${film.youtubeId}`} target="_blank" rel="noopener">
              Voir le film en entier
            </a>
          )
        }
      </div>
      <p class="credit">
        {film.title ?? <span class="placeholder">[À COMPLÉTER — titre du film]</span>}
        <span>{film.credit}</span>
      </p>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (video && toggle) {
    let userPaused = reduced;

    const render = () => {
      toggle.textContent = video.paused ? 'Lecture' : 'Pause';
      toggle.setAttribute('aria-pressed', String(video.paused));
    };

    const play = () => video.play().catch(() => {}).finally(render);

    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) video.pause();
      else play();
      render();
    });

    // Lecture uniquement quand le film est visible, jamais si le visiteur l'a mis en pause
    new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting && !userPaused) play();
      else video.pause();
      render();
    }).observe(video);

    render();
  }
</script>

<style>
  .hero-film {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: var(--space-6) calc(var(--space-12) + 4.5rem);
  }

  /* Fond : l'image du film, très floutée, pour prolonger son ambiance */
  .hero-film::before {
    content: '';
    position: absolute;
    inset: -10%;
    z-index: -1;
    background: var(--backdrop) center / cover;
    filter: blur(40px) brightness(0.45) saturate(1.2);
  }

  .inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .film {
    position: relative;
    margin: 0;
    /* sur mobile, le film laisse apparaître le début du titre */
    width: min(100%, 480px, 60svh * 720 / 894);
    justify-self: center;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.6);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .toggle {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 999px;
    background: rgb(21 10 34 / 0.6);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(6px);
  }

  h2 {
    font-size: var(--text-3xl);
    max-width: 16ch;
  }

  .lead {
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block: var(--space-6);
  }

  .watch {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .watch:hover {
    color: var(--color-paper);
    text-decoration-color: var(--color-rose);
  }

  .credit {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    opacity: 0.85;
  }

  @media (min-width: 48em) {
    .hero-film {
      min-height: calc(100svh - var(--header-height));
      display: grid;
      align-items: center;
      padding-block: var(--space-12);
    }

    .inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-16);
    }

    .film {
      order: 2;
      max-width: none;
      max-height: calc(100svh - var(--header-height) - var(--space-24));
      width: auto;
      height: calc(100svh - var(--header-height) - var(--space-24));
    }
  }
</style>
